# Application Environment Settings
PROJECT_NAME="Student Success Early-Warning System"
ENV="development"
DEBUG=true

# Security & Authentication
# Generate a strong 256-bit secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY="development-only-insecure-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default to SQLite for zero-setup instant local running; use PostgreSQL for production
DATABASE_URL="sqlite:///./early_warning.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/student_early_warning"

# Machine Learning & Thresholds
MODEL_ARTIFACTS_DIR="ml/artifacts"
DEFAULT_LOW_THRESHOLD=30.0
DEFAULT_MEDIUM_THRESHOLD=60.0

# CORS & Server Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
HOST="127.0.0.1"
PORT=8000
