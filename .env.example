# ========================================================
# UDAAN Student Success & Early-Warning System
# Backend Environment Configuration Template
# ========================================================

# Application Settings
PROJECT_NAME="Student Success Early-Warning System"
ENV="production"
DEBUG=false

# Security & Authentication
# IMPORTANT: Generate a secure 256-bit random key for production (e.g., openssl rand -hex 32)
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (Production Persistent Database)
# In production on Render/Supabase/Neon, use PostgreSQL for persistent data storage:
DATABASE_URL="postgresql://username:password@hostname:5432/database_name"
# For local offline development fallback only:
# DATABASE_URL="sqlite:///./early_warning.db"

# Machine Learning & Thresholds
MODEL_ARTIFACTS_DIR="ml/artifacts"
DEFAULT_LOW_THRESHOLD=30.0
DEFAULT_MEDIUM_THRESHOLD=60.0

# Authorized CORS Origins (Comma-separated list or JSON array)
# Restrict strictly to your authorized deployed frontend domain(s) and local dev:
CORS_ORIGINS="https://minor-project-design.vercel.app,http://localhost:5173,http://127.0.0.1:5173"

# Network Binding
HOST="0.0.0.0"
PORT=8000
