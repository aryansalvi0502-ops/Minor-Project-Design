# ========================================================
# UDAAN Student Success & Early-Warning System
# Frontend Environment Configuration Template
# ========================================================

# The public HTTPS API base URL for the backend FastAPI service.
# For Vercel production deployment:
# Set this variable in Vercel Project Settings -> Environment Variables
# Example: https://udaan-early-warning-api.onrender.com/api/v1
VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN/api/v1

# Backward-compatibility alias (optional, VITE_API_BASE_URL takes precedence)
# VITE_API_URL=https://YOUR-BACKEND-DOMAIN/api/v1
